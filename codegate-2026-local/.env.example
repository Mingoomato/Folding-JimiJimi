# CODEGATE 설정 — 이 파일 하나만 본다.
#
# 이 저장소만 실행할 때는 `.env` 로 복사한다. 통합 산출물에서는 루트 launcher가 루트의
# `.env` 하나를 읽고 이 Electron process에 같은 값을 상속한다. `pnpm dev`,
# `pnpm dev:integrated`, 설치본은 이 폴더의 `.env`를 읽는다(src/main/env.ts).
# **실제 환경변수가 있으면 그쪽이 이긴다** — `.env` 는 빈 자리만 채운다.
#
# `.env` 는 gitignore 대상이다. 자격증명을 예제 파일에 적지 말 것.

# ── 팀 산출물 경로 ────────────────────────────────────────────────────────
# 비워 두면 sibling 기본 경로를 탐색한다. 저장소 이름이 다르면 여기서 메운다.

# 민규 — doc2md (문서 → Markdown 변환)
CODEGATE_DOC2MD_PROJECT_ROOT=/absolute/path/to/codegate-2026-convert/services/doc2md
CODEGATE_DOC2MD_PYTHON=/absolute/path/to/codegate-2026-convert/services/doc2md/.venv/bin/python
# OCR 모델/cache 위치. dev:integrated가 자격증명은 걸러내면서 이 값은 doc2md에 전달한다.
DOC2MD_DATA_ROOT=/absolute/path/to/folding/.data/doc2md
# 별도로 띄운 doc2md 에 붙을 때만. dev:integrated 는 직접 띄우고 이 값을 자동으로 넣는다.
# CODEGATE_DOC2MD_URL=http://127.0.0.1:9000

# 성주 — codegate-local sidecar (에이전트 · 변경계획 · 실행)
CODEGATE_SIDECAR_BIN=/absolute/path/to/codegate-2026-agent/.venv/bin/codegate-local

# 용휘 — LLMWIKI 빌더
CODEGATE_LLMWIKI_PROJECT_ROOT=/absolute/path/to/LLMWIKI

# ── 인증 ─────────────────────────────────────────────────────────────────
# local  = 로그인 우회 (개발 기본값)
# cloud  = 실제 Google OAuth. CODEGATE_CLOUD_API_URL 이 가리키는 서버로 붙는다.
CODEGATE_AUTH_MODE=local
CODEGATE_CLOUD_API_URL=http://127.0.0.1:8000/api/v1
# Google Console "승인된 리디렉션 URI" 와 **글자 그대로** 같아야 한다 (경로까지 정확히).
CODEGATE_OAUTH_REDIRECT_URI=http://127.0.0.1:47821/auth/callback

# ── 문서 분석 LLM ────────────────────────────────────────────────────────
# 통합 launcher의 기본 에이전트는 Gemini 2.5 Flash-Lite다. Gemini 모드에서는 Anthropic
# 키가 필요하지 않다. 실제 키는 통합 루트 `.env`에만 두고 예제에는 절대 적지 않는다.
CODEGATE_AGENT_MODE=gemini
CODEGATE_GEMINI_MODEL=gemini-2.5-flash-lite
CODEGATE_GEMINI_TIMEOUT_SECONDS=90
# 내부 문서를 Gemini에 보내는 통합 설정. 유료 Gemini API 프로젝트의 no-training 정책을
# 확인한 경우에만 이 값을 사용한다. launcher가 이 값만 sidecar로 전달한다.
CODEGATE_GEMINI_DATA_POLICY=paid-no-training
GEMINI_API_KEY=

# Claude 모드로 명시 전환할 때만 필요하다.
# CODEGATE_ANTHROPIC_API_KEY=sk-ant-...
# 로컬 enrichment 빌더도 같은 GEMINI_API_KEY를 사용한다. OpenAI provider는 구현돼 있지 않다.

CODEGATE_CLAUDE_MODEL=sonnet
CODEGATE_CLAUDE_TIMEOUT_SECONDS=180
# LLM 없이 파이프라인만 돌릴 때 (결정적 응답)
# CODEGATE_AGENT_MODE=deterministic

# ── 원격 에이전트 서버에 붙기 ─────────────────────────────────────────────
# 켜면 로컬 sidecar 를 띄우지 않고 그 서버에 붙는다.
# 주의: 그 서버는 **자기 코퍼스**로 답한다 — 이 컴퓨터에 등록한 폴더가 아니다.
# CODEGATE_SIDECAR_URL=https://example.up.railway.app/api/v1
