# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:5173

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="CODEGATE AI Startup Hackathon MVP"

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173"

# Supabase project — Settings > API in the Supabase dashboard
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Settings > API > JWT Settings > "JWT Secret"
SUPABASE_JWT_SECRET=changethis
# Optional, only for backend scripts that call the Supabase Admin API.
# Never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Emails (optional)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Supabase Postgres — Project Settings > Database in the Supabase dashboard.
# Use the "connection pooler" (transaction mode, port 6543) host for a
# typical request-scoped FastAPI app; use the direct connection (port 5432)
# only for one-off scripts/migrations that need a session-scoped connection.
POSTGRES_SERVER=db.xxxxxxxxxxxx.supabase.co
POSTGRES_PORT=6543
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
POSTGRES_SSLMODE=require

SENTRY_DSN=
