# 이 파일을 `.env`로 복사한 뒤 아래 세 값만 입력하세요.
# 따옴표 없이 값만 넣습니다. 실제 `.env`는 Git에서 제외됩니다.
GEMINI_API_KEY=
CODEGATE_GOOGLE_CLIENT_ID=
CODEGATE_GOOGLE_CLIENT_SECRET=

# 고정 통합 설정 — 특별한 이유가 없으면 바꾸지 마세요.
CODEGATE_GEMINI_MODEL=gemini-2.5-flash-lite
CODEGATE_GEMINI_DATA_POLICY=paid-no-training
CODEGATE_AGENT_MODE=gemini
CODEGATE_AUTH_MODE=cloud
CODEGATE_CLOUD_API_URL=http://127.0.0.1:8000/api/v1
CODEGATE_OAUTH_REDIRECT_URI=http://127.0.0.1:47821/auth/callback
CODEGATE_API_HOST=127.0.0.1
CODEGATE_API_PORT=8000

# setup이 생성할 수 있는 서버 전용 값입니다. 32자 이상의 무작위 값을 사용하세요.
CODEGATE_SESSION_PEPPER=replace-with-at-least-32-random-characters
