CODEGATE_ENVIRONMENT=development
CODEGATE_API_HOST=127.0.0.1
CODEGATE_API_PORT=8000
CODEGATE_CORS_ORIGINS='["http://localhost:5173"]'
CODEGATE_DATABASE_PATH=.runtime/cloud-api.sqlite3

# Google Cloud Console에서 "Web application" OAuth client를 만든 뒤 설정한다.
# Authorized redirect URI: http://127.0.0.1:47821/auth/callback
CODEGATE_GOOGLE_CLIENT_ID=
CODEGATE_GOOGLE_CLIENT_SECRET=

# 최소 32자의 무작위 값. 저장소에 실제 값을 커밋하지 않는다.
CODEGATE_SESSION_PEPPER=

# OAuth start abuse protection. Gateway에서도 별도 rate limit을 적용한다.
CODEGATE_OAUTH_START_RATE_LIMIT_REQUESTS=30
CODEGATE_OAUTH_START_RATE_LIMIT_WINDOW_SECONDS=60
CODEGATE_MAX_PENDING_OAUTH_FLOWS=10000
CODEGATE_REFRESH_RATE_LIMIT_REQUESTS=120
CODEGATE_REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
CODEGATE_MAX_REFRESH_ROTATIONS_PER_FAMILY=2048
CODEGATE_EXPIRED_DATA_CLEANUP_INTERVAL_SECONDS=300
