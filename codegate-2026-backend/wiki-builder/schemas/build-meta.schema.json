{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/build-meta.schema.json",
  "title": "Immutable Wiki Build Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "wiki_version", "build_format_version", "tenant_id", "wiki_id", "build_id", "source_digest", "model_fingerprint", "provider", "model", "counts", "enrichment_statuses", "usage", "complete"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "wiki_version": {"type": "string"},
    "build_format_version": {"const": "server-v2"},
    "tenant_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"},
    "wiki_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"},
    "build_id": {"type": "string", "pattern": "^build-[0-9a-f]{20}$"},
    "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider": {"type": "string"},
    "model": {"type": "string"},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["documents", "source_fragments", "chunks", "aliases", "links", "enrichments"],
      "properties": {
        "documents": {"type": "integer", "minimum": 0},
        "source_fragments": {"type": "integer", "minimum": 0},
        "chunks": {"type": "integer", "minimum": 0},
        "aliases": {"type": "integer", "minimum": 0},
        "links": {"type": "integer", "minimum": 0},
        "enrichments": {"type": "integer", "minimum": 0}
      }
    },
    "enrichment_statuses": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["measured_records", "unmeasured_records", "input_tokens", "output_tokens", "total_tokens", "estimated_cost", "currency"],
      "properties": {
        "measured_records": {"type": "integer", "minimum": 0},
        "unmeasured_records": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "estimated_cost": {"type": "number", "minimum": 0},
        "currency": {"type": "string"}
      }
    },
    "complete": {"type": "boolean"}
  }
}
