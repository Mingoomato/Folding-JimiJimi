{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/enrichment.schema.json",
  "title": "Grounded LLM Enrichment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "doc_id", "source_sha256", "model_fingerprint", "prompt_version",
    "summary", "key_points", "keywords", "entities", "faq", "relations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "doc_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$", "maxLength": 96},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_fingerprint": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "attempt_count", "usage"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "attempt_count": {"type": "integer", "minimum": 1},
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_tokens", "output_tokens", "total_tokens", "estimated_cost", "currency"],
          "properties": {
            "input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0},
            "total_tokens": {"type": "integer", "minimum": 0},
            "estimated_cost": {"type": "number", "minimum": 0},
            "currency": {"type": "string", "minLength": 3},
            "pricing_effective_on": {"type": "string"}
          }
        }
      }
    },
    "summary": {"$ref": "#/$defs/groundedText"},
    "key_points": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"$ref": "#/$defs/groundedText"}},
    "keywords": {"type": "array", "minItems": 5, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "entities": {
      "type": "array", "maxItems": 8, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "type", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"enum": ["organization", "role", "system", "process", "document", "asset", "other"]},
          "evidence": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/evidence"}}
        }
      }
    },
    "faq": {
      "type": "array", "minItems": 2, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["question", "answer", "evidence"],
        "properties": {
          "question": {"type": "string", "minLength": 1},
          "answer": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/evidence"}}
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["to_doc_id", "relation_type", "evidence"],
        "properties": {
          "to_doc_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$", "maxLength": 96},
          "relation_type": {"enum": ["references", "implements", "implemented_by", "based_on", "supersedes", "superseded_by"]},
          "evidence": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/evidence"}}
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["section_id", "quote"],
      "properties": {
        "section_id": {"type": "string", "pattern": "^sec-[0-9a-f]{10}$"},
        "quote": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "groundedText": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "evidence"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/evidence"}}
      }
    }
  }
}
