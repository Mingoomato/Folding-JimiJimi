{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/manifest.schema.json",
  "title": "LLM Wiki Manifest Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "wiki_version", "doc_id", "revision", "title", "doc_type",
    "language", "status", "official_number", "authority_level", "issuing_org",
    "issued_on", "effective_from", "effective_to", "path", "access", "tags",
    "aliases", "source", "ingest", "content_sha256", "section_count", "chunk_count",
    "source_fragment_count", "chunking_mode", "link_count", "summary", "keywords",
    "enrichment"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "wiki_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "doc_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$", "maxLength": 96},
    "revision": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "doc_type": {"enum": ["regulation", "policy", "procedure", "manual", "guide", "specification", "contract", "report", "meeting_note", "general"]},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
    "status": {"enum": ["active", "draft", "archived", "superseded"]},
    "official_number": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1}
      ]
    },
    "authority_level": {
      "enum": ["regulation", "policy", "contract", "procedure", "manual", "guide", "specification", "report", "reference", null]
    },
    "issuing_org": {"type": ["string", "null"], "minLength": 1},
    "issued_on": {"$ref": "#/$defs/dateOrNull"},
    "effective_from": {"$ref": "#/$defs/dateOrNull"},
    "effective_to": {"$ref": "#/$defs/dateOrNull"},
    "path": {"type": "string", "pattern": "^docs/(regulations|policies|procedures|manuals|guides|specifications|contracts|reports|meeting-notes|general)/.+\\.md$"},
    "access": {"enum": ["public", "internal", "restricted"]},
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["filename", "uri", "sha256", "verification"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "verification": {"enum": ["verified", "unavailable"]}
      }
    },
    "ingest": {
      "type": "object", "additionalProperties": false,
      "required": ["aggregate_sha256", "fragments"],
      "properties": {
        "aggregate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fragments": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["chunk_no", "path", "sha256"],
            "properties": {
              "chunk_no": {
                "type": ["string", "null"],
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "path": {"type": "string", "pattern": "^source-md/.+\\.md$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "source_fragment_count": {"type": "integer", "minimum": 1},
    "chunking_mode": {"enum": ["sections", "source-fragments"]},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "section_count": {"type": "integer", "minimum": 1},
    "chunk_count": {"type": "integer", "minimum": 1},
    "link_count": {"type": "integer", "minimum": 0},
    "summary": {"type": ["string", "null"]},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "enrichment": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "model", "prompt_version", "record_ref"],
      "properties": {
        "status": {"enum": ["pending", "approved", "needs-review", "stale"]},
        "model": {"type": ["string", "null"]},
        "prompt_version": {"type": ["string", "null"]},
        "record_ref": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "dateOrNull": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      ]
    }
  }
}
