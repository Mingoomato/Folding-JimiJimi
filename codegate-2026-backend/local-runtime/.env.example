LLMWIKI_CONFIG_PATH=../wiki-builder/config/wiki.yaml
LLMWIKI_STATE_DIR=../local-data
LLMWIKI_BOOTSTRAP_INPUT_DIR=../local-data/bootstrap-input
LLMWIKI_STORAGE_ROOT=../wiki-storage
LLMWIKI_CONVERTER_URL=http://127.0.0.1:8123
LLMWIKI_TENANT_ID=personal
LLMWIKI_WIKI_ID=main
LLMWIKI_ACTOR_ID=local-document-runtime
LLMWIKI_API_HOST=127.0.0.1
LLMWIKI_API_PORT=8765
# 프론트와 로컬 런타임 사이의 임의 문자열. 비워두면 인증을 검사하지 않는다.
LLMWIKI_API_TOKEN=
# 쉼표로 구분한 프론트 Origin. 와일드카드는 허용하지 않는다.
LLMWIKI_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# 쉼표로 구분한 원본 루트. 설정하면 이 폴더 밖의 source_path는 거부한다.
LLMWIKI_ALLOWED_SOURCE_ROOTS=
LLMWIKI_RUN_ENRICHMENT=true
LLMWIKI_SYNTHETIC_CORPUS=false
LLMWIKI_CONVERTER_TIMEOUT_SECONDS=1800
LLMWIKI_CONVERTER_POLL_SECONDS=0.5
LLMWIKI_MAX_SOURCE_BYTES=536870912
