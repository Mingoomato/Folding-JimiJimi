# 개발용 예시입니다. JSON 배열은 그대로 유지합니다.
CODEGATE_ENVIRONMENT=development
CODEGATE_CORS_ORIGINS='["http://localhost:3000"]'
CODEGATE_AUTH_MODE=demo
CODEGATE_DEMO_AUTH_TOKEN=development-demo-token-not-secret # gitleaks:allow
CODEGATE_AGENT_MODE=deterministic
CODEGATE_BOOTSTRAP_DEMO=true

# Gemini REST gateway. API key는 URL이나 로그에 넣지 않고 x-goog-api-key header로만 보냅니다.
GEMINI_API_KEY=
CODEGATE_GEMINI_MODEL=gemini-2.5-flash-lite
CODEGATE_GEMINI_TIMEOUT_SECONDS=45
# development-free에서는 public 근거만 전송합니다. 실제 billed Gemini 프로젝트의 key를
# 사용하는 경우에만 paid-no-training으로 바꿔 internal/restricted 근거 전송을 허용하세요.
CODEGATE_GEMINI_DATA_POLICY=development-free

# Claude Agent SDK를 연결할 때 서버 환경변수로만 설정합니다.
ANTHROPIC_API_KEY=
# CODEGATE_CLAUDE_MODEL=<exact-model-id>
# CODEGATE_CLAUDE_SESSION_TTL_SECONDS=3600

# 다운로드 앱은 `codegate-local` CLI 사용을 권장합니다. 환경변수로 실행할 때의 계약입니다.
# source, input, storage 경로는 서로 겹치면 안 됩니다.
# CODEGATE_ENVIRONMENT=local
# CODEGATE_AUTH_MODE=local
# CODEGATE_AGENT_MODE=gemini
# CODEGATE_BOOTSTRAP_DEMO=false
# CODEGATE_KNOWLEDGE_MODE=llmwiki
# CODEGATE_SOURCE_ROOT=/absolute/workspace/source
# CODEGATE_LLMWIKI_PROJECT_ROOT=/absolute/app/LLMWIKI
# CODEGATE_LLMWIKI_INPUT_ROOT=/absolute/workspace/source-md
# CODEGATE_LLMWIKI_STORAGE_ROOT=/absolute/app-data/llmwiki
# CODEGATE_DOC2MD_BASE_URL=http://127.0.0.1:8931
# CODEGATE_DOC2MD_SOURCE_KIND=path
# CODEGATE_DOC2MD_API_TOKEN=

# 별도 doc2md service에는 승인된 원본을 최대 32 MiB inline bytes로 전송합니다.
# CODEGATE_DOC2MD_SOURCE_KIND=bytes
# CODEGATE_DOC2MD_MAX_SOURCE_BYTES=33554432

# Supabase JWT 검증을 연결할 때 서버가 필요한 값입니다. service-role key는 사용하지 않습니다.
CODEGATE_SUPABASE_URL=
CODEGATE_SUPABASE_JWT_AUDIENCE=authenticated
CODEGATE_SUPABASE_JWKS_TIMEOUT_SECONDS=3

# 인증/JWKS 오용과 멈춘 outbox를 조기에 감지하는 서버 보호 기본값입니다.
CODEGATE_AUTH_RATE_LIMIT_REQUESTS=240
CODEGATE_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
CODEGATE_AUTHORIZATION_HEADER_MAX_BYTES=8192
CODEGATE_SYNC_STALE_AFTER_SECONDS=30

# Railway production에서만 플랫폼이 제공하는 volume mount 경로를 사용합니다.
# RAILWAY_VOLUME_MOUNT_PATH=/data
